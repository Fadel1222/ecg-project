   "source": [
    "spectrum = np.abs(np.fft.rfft(signal - np.mean(signal)))\n",
    "freqs = np.fft.rfftfreq(len(signal), d=1/fs)\n",
    "\n",
    "plt.figure(figsize=(12, 3))\n",
    "plt.plot(freqs, spectrum)\n",
    "plt.xlim(0, 60)\n",
    "plt.xlabel('Frequency (Hz)')\n",
    "plt.ylabel('Magnitude')\n",
    "plt.show()"
   ]
  }
